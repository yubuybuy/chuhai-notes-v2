---
import { PortableText } from "astro-portabletext";
import DealOverview from "@/components/DealOverview.astro";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import EditPost from "../_components/EditPost.astro";
import ShareLinks from "../_components/ShareLinks.astro";
import BackButton from "../_components/BackButton.astro";
import BackToTopButton from "../_components/BackToTopButton.astro";
import AdjacentPostNav from "../_components/AdjacentPostNav.astro";
import PostToc from "../_components/PostToc.astro";
import config from "@/config";
import {
  getAllPosts,
  getDeal,
  dealToPost,
  headingsFromBody,
  type Deal,
} from "@/lib/content";
import { portableTextComponents } from "@/lib/portable-text";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const deals = posts.filter(p => p.data.dealManaged);
  return deals.map((post, index) => ({
    params: { slug: post.id.replace(/^deals\//, "") },
    props: {
      post,
      prevPost:
        index < deals.length - 1
          ? {
              id: deals[index + 1].id,
              title: deals[index + 1].data.title,
              filePath: deals[index + 1].filePath,
            }
          : null,
      nextPost:
        index > 0
          ? {
              id: deals[index - 1].id,
              title: deals[index - 1].data.title,
              filePath: deals[index - 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: ReturnType<typeof dealToPost>;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  audience,
  keywords,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  hideToc,
} = post.data;

const slug = post.id.replace(/^deals\//, "");
const deal: Deal | null = await getDeal(slug);
if (!deal) throw new Error(`Deal not found in data layer: ${slug}`);

const tocHeadings =
  config.features.toc && !hideToc ? headingsFromBody(deal.body) : [];
---

<PostLayout
  keywords={keywords}
  title={`${title} | ${config.site.title}`}
  description={description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
  >
    <h1
      style={{ viewTransitionName: toTransitionName(post.id) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      <span
        aria-hidden="true"
        class:list={[
          "text-muted-foreground max-sm:hidden",
          { hidden: !config.features.editPost?.enabled || hideEditPost },
        ]}
      >
        |
      </span>
      <EditPost {hideEditPost} {post} class="max-sm:hidden" />
    </div>

    <p class="my-4 leading-7">
      <strong>适用人群：</strong>{audience}
    </p>
    <div class="post-body mt-8">
      <DealOverview {post} />
      <PostToc headings={tocHeadings} />
      <article
        id="article"
        class:list={[
          "w-full",
          "app-prose max-w-app",
          "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
        ]}
      >
        <PortableText value={deal.body} components={portableTextComponents} />
      </article>
    </div>

    <hr class="my-8 border-dashed" />

    <BackToTopButton headings={tocHeadings} />

    <div class="sm:my-8 sm:flex sm:items-start sm:justify-between sm:gap-8">
      <div class="mt-4 mb-8 flex items-start justify-between gap-4 sm:my-0">
        <ul class="flex flex-wrap gap-4">
          {
            tags.map(tag => (
              <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />
            ))
          }
        </ul>
        <EditPost class="flex-none sm:hidden" {hideEditPost} {post} />
      </div>

      <ShareLinks />
    </div>

    <hr class="my-8 border-dashed" />

    <AdjacentPostNav {prevPost} {nextPost} />
  </main>
  <Footer />
</PostLayout>
